{
  "name": "appinity-claude",
  "version": "0.1.0",
  "private": true,
  "description": "APPINITY · implementación independiente (Claude). Descubre recomendaciones de tus almas gemelas y conoce a las personas que comparten tus gustos.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:ps": "docker compose ps",
    "build": "tsc -b tsconfig.build.json",
    "build:watch": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "pnpm build && tsc -p tsconfig.tests.json && pnpm --filter @appinity/mobile typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "pnpm build && vitest run --project integration",
    "db:generate": "pnpm --filter @appinity/database generate",
    "db:migrate": "pnpm build && node --env-file-if-exists=.env packages/database/dist/cli/migrate.js",
    "db:seed": "pnpm build && node --env-file-if-exists=.env packages/ingestion/dist/cli/seed-demo.js",
    "db:reset": "pnpm build && node --env-file-if-exists=.env packages/database/dist/cli/reset.js && pnpm db:migrate && pnpm db:seed",
    "user:local": "pnpm build && node --env-file-if-exists=.env packages/ingestion/dist/cli/create-local-user.js",
    "api": "pnpm build && node --env-file-if-exists=.env apps/api/dist/main.js",
    "worker": "pnpm build && node --env-file-if-exists=.env workers/sync-worker/dist/main.js",
    "dev": "pnpm build && concurrently -k -n build,api,worker -c gray,cyan,magenta \"pnpm build:watch\" \"node --env-file-if-exists=.env --watch apps/api/dist/main.js\" \"node --env-file-if-exists=.env --watch workers/sync-worker/dist/main.js\"",
    "mobile": "pnpm build && pnpm --filter @appinity/mobile start",
    "fixtures:catalog": "node scripts/fixtures/build-catalog-snapshot.mjs",
    "secret:set": "node scripts/set-secret.mjs"
  },
  "devDependencies": {
    "@appinity/algorithms": "workspace:*",
    "@appinity/catalog": "workspace:*",
    "@appinity/database": "workspace:*",
    "@appinity/i18n": "workspace:*",
    "@appinity/ingestion": "workspace:*",
    "@appinity/integrations": "workspace:*",
    "@appinity/shared": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
