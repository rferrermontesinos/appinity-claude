# APPINITY (implementación Claude) · configuración local de desarrollo.
# Copia generada por `pnpm setup`, que rellena secretos aleatorios y la IP de tu red.
# Nunca subas .env a Git.

# Entorno: development | test | production
NODE_ENV=development

# DEMO_MODE habilita fixtures simulados, el seed de demo y las fuentes "fixture_*".
# Prohibido en producción: la API y el worker se niegan a arrancar si NODE_ENV=production.
DEMO_MODE=true

# Identidad de desarrollo (no es autenticación de producción). Solo con DEMO_MODE=true.
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=

# Clave AES-256-GCM para cifrar credenciales de proveedores (32 bytes en base64).
CREDENTIALS_ENCRYPTION_KEY=

# Servicios locales (docker-compose.yml, proyecto appinity-claude)
POSTGRES_PORT=5442
REDIS_PORT=6390
DATABASE_URL=postgres://appinity_claude:appinity_claude_dev@127.0.0.1:5442/appinity_claude
TEST_DATABASE_URL=postgres://appinity_claude:appinity_claude_dev@127.0.0.1:5442/appinity_claude_test
REDIS_URL=redis://127.0.0.1:6390

# API. 0.0.0.0 permite que el teléfono la alcance por la red local.
API_HOST=0.0.0.0
API_PORT=3100
# URL pública de la API para construir URLs de imágenes cacheadas. Vacía = se deduce de la petición.
PUBLIC_API_URL=

# Directorio local de almacenamiento de imágenes (sustituible por S3 compatible más adelante).
STORAGE_DIR=.data/media

# Steam Web API (clave de usuario de https://steamcommunity.com/dev/apikey). Solo servidor; nunca en Git ni en el móvil.
# Guárdala con `pnpm secret:set STEAM_WEB_API_KEY` (no se muestra en pantalla). Vacía = Steam aparece como «sin configurar».
STEAM_WEB_API_KEY=

# Google Data Portability: cliente OAuth de tipo «Aplicación web» del proyecto de Google Cloud (ver README, «Conectar tu
# cuenta de Google»). Guárdalos con `pnpm secret:set GOOGLE_OAUTH_CLIENT_ID --clipboard` y
# `pnpm secret:set GOOGLE_OAUTH_CLIENT_SECRET --clipboard`. Vacíos = Google aparece como «sin configurar».
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la URI de redirección autorizada del cliente. Google solo admite http con localhost.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3100/v1/connect/google_portability/callback

# Horas entre syncs programados de fuentes reales (el worker revisa cada hora).
SYNC_INTERVAL_HOURS=24

# Prefijo de colas BullMQ (aísla las claves Redis de otras instalaciones).
QUEUE_PREFIX=appinity-claude
