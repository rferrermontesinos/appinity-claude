{
  "expo": {
    "name": "APPINITY (Claude)",
    "slug": "appinity-claude",
    "scheme": "appinity-claude",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.appinity.claude",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "APPINITY usa tu ubicación una sola vez para fijar una zona aproximada (restaurantes, cultura y comunidad local)."
      }
    },
    "android": {
      "package": "dev.appinity.claude",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0C0E"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C0C0E"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "APPINITY lee los emails de tu agenda solo cuando lo pides, para encontrar a quien ya usa la app. No se sube tu agenda."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "APPINITY usa tu ubicación una sola vez para fijar una zona aproximada (restaurantes, cultura y comunidad local)."
        }
      ]
    ],
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
