# URL de la API vista desde el TELÉFONO (no uses localhost: en el móvil apunta al propio móvil).
# Si se deja vacía, la app usa la IP del servidor de Metro con el puerto 3100.
EXPO_PUBLIC_API_URL=http://192.168.1.16:3100

# Notificaciones push (fase B6). Id del proyecto de EAS («eas init»); sin él, la app no pide token de push.
# Para Android hace falta además apps/mobile/google-services.json (Firebase, ignorado por Git). Ver docs/operations.md.
# EAS_PROJECT_ID=
