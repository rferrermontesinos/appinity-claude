{
  "name": "@appinity/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App móvil APPINITY (Expo SDK 57, Expo Router). Compatible con Expo Go.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8091",
    "start:clear": "expo start --port 8091 --clear",
    "android": "expo start --port 8091 --android",
    "ios": "expo start --port 8091 --ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "doctor": "expo-doctor",
    "export:check": "expo export --platform android --platform ios --output-dir .expo/export-check",
    "web": "expo start --web --port 8092"
  },
  "dependencies": {
    "@appinity/i18n": "workspace:*",
    "@appinity/shared": "workspace:*",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "5.104.1",
    "expo": "57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18next": "26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.18"
  }
}
